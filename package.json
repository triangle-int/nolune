{
	"name": "nolune",
	"version": "0.5.0",
	"description": "A small agent that lives on your computer and does things for your family, from a shared web chat.",
	"license": "MIT",
	"author": "Triangle Interactive, LLC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/triangle-int/nolune.git"
	},
	"homepage": "https://github.com/triangle-int/nolune#readme",
	"bugs": {
		"url": "https://github.com/triangle-int/nolune/issues"
	},
	"type": "module",
	"keywords": [
		"agent",
		"claude",
		"anthropic",
		"family",
		"self-hosted",
		"llm"
	],
	"bin": {
		"nolune": "dist/cli.js"
	},
	"files": [
		"packages/web/build",
		"!packages/web/build/**/*.map",
		"dist",
		"packages/core/drizzle",
		"packages/core/skills",
		"packages/core/image-templates",
		"DESIGN.md"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm --filter @nolune/web dev",
		"build": "pnpm --filter @nolune/web build && node scripts/build-cli.mjs",
		"preview": "pnpm --filter @nolune/web preview",
		"check": "pnpm -r check",
		"check:watch": "pnpm --filter @nolune/web check:watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"db:generate": "pnpm --filter @nolune/core db:generate",
		"db:studio": "pnpm --filter @nolune/core db:studio",
		"nolune": "node --no-warnings packages/cli/src/index.ts",
		"start": "node --no-warnings packages/cli/src/index.ts start",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.128.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.2"
	}
}
