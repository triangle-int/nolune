{
	"name": "nolune",
	"version": "0.0.1",
	"description": "A small agent that lives on your computer and does things for your family, from a shared web chat.",
	"private": true,
	"type": "module",
	"keywords": [
		"agent",
		"claude",
		"anthropic",
		"family",
		"self-hosted",
		"llm"
	],
	"bin": {
		"nolune": "dist/cli.js"
	},
	"files": [
		"build",
		"dist",
		"packages/core/drizzle",
		"packages/core/skills",
		"packages/core/image-templates",
		"DESIGN.md"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-cli.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p packages/core && tsc -p packages/cli",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"nolune": "node --no-warnings packages/cli/src/index.ts",
		"start": "node --no-warnings packages/cli/src/index.ts start",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource/fira-mono": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.48.0",
		"@nolune/cli": "workspace:*",
		"@nolune/core": "workspace:*",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.19.3",
		"cn": "^0.4.0",
		"dompurify": "^3.4.16",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"emoji-picker-element": "^1.29.1",
		"emoji-picker-element-data": "^1.8.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lucide": "^1.48.0",
		"marked": "^18.0.14",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.2"
	}
}
