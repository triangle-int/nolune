<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The gateway in the background, registered by the app with SMAppService (Service.swift).
	launchd runs the app's own executable, which starts `node cli.js start` as its child, so macOS
	counts the gateway as the app for Full Disk Access. Same label as `nolune service install`.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.nolune.gateway</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Nolune</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/Nolune</string>
		<string>--gateway</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.nolune.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
