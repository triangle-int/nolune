# For development (pnpm --filter @nolune/api dev). On a server, packages/relay/compose.api.yaml
# runs the API, with its secrets in packages/relay/api.env (api.env.example there).
# Postgres: a local one, or one in Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_USER=nolune -e POSTGRES_PASSWORD=nolune -e POSTGRES_DB=nolune_api postgres:17-alpine
DATABASE_URL=postgres://nolune:nolune@localhost:5432/nolune_api
# Signs sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the service is: vite dev's address in development
ORIGIN=http://localhost:5173
# Sends sign-in codes. Without it they're printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=nolune <account@nolune.dev>
# nolune's key at OpenRouter, which every plan's requests go on
OPENROUTER_API_KEY=
# Chats carry their pictures and PDFs inline (up to 20 MB), past adapter-node's 512 KB
BODY_SIZE_LIMIT=32M
# Behind Caddy, so the sign-in limits see people's addresses rather than Caddy's
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# Stripe sells the plan. Without the secret key the account page has nothing to buy.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret: an endpoint at <ORIGIN>/stripe/webhook, API version
# 2026-09-30.endive, with invoice.paid, checkout.session.completed,
# checkout.session.async_payment_succeeded and customer.subscription.deleted
# (stripe listen --forward-to localhost:5173/stripe/webhook prints one in development)
STRIPE_WEBHOOK_SECRET=
# nolune's own customer portal configuration (bpc_…): cancelling, cards and invoices, no switching
STRIPE_PORTAL_CONFIGURATION=
# true once Managed Payments is on in the Dashboard: Stripe is then the merchant of record
STRIPE_MANAGED_PAYMENTS=false
