# nolune's API's secrets, for compose.api.yaml: copy to api.env, fill in, and keep it to yourself
# (chmod 600 api.env). DATABASE_URL and ORIGIN come from .env's API_DB_PASSWORD and API_HOST.

# Signs sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Sends sign-in codes, from an address on a domain Resend has verified: mail.nolune.dev, a
# subdomain, so what it sends doesn't weigh on nolune.dev's own reputation
RESEND_API_KEY=
EMAIL_FROM=nolune <account@mail.nolune.dev>
# nolune's own key at OpenRouter, which every family's requests go on. Give it a credit limit.
OPENROUTER_API_KEY=

# Stripe. Without the secret key the account page sells nothing (the plan can't be bought yet).
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret: an endpoint at https://<API_HOST>/stripe/webhook,
# API version 2026-09-30.endive, with invoice.paid, checkout.session.completed,
# checkout.session.async_payment_succeeded and customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# nolune's customer portal configuration (bpc_...): cancelling, cards and invoices, no switching
STRIPE_PORTAL_CONFIGURATION=
# true once Managed Payments is on in the Dashboard
STRIPE_MANAGED_PAYMENTS=false
