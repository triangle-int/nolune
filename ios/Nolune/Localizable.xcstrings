{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ answered with an error (%lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mit einem Fehler geantwortet (%2$lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió con un error (%2$lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a répondu par une erreur (%2$lld)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ответил ошибкой (%2$lld)."
          }
        }
      }
    },
    "%@ is deleted for everyone in the profile. Its chats move back to your chat list, without its instructions and files. The files are moved to ~/.nolune/trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird für alle im Profil gelöscht. Seine Chats kommen zurück in deine Chatliste, ohne seine Anweisungen und Dateien. Die Dateien werden nach ~/.nolune/trash verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se elimina para todos en el perfil. Sus chats vuelven a tu lista de chats, sin sus instrucciones ni archivos. Los archivos se mueven a ~/.nolune/trash."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est supprimé pour tout le monde dans le profil. Ses discussions reviennent dans votre liste, sans ses instructions ni ses fichiers. Les fichiers sont déplacés dans ~/.nolune/trash."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка %@ удалится у всех в профиле. Её чаты вернутся в общий список, но без её инструкций и файлов. Файлы переместятся в ~/.nolune/trash."
          }
        }
      }
    },
