{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Every weekday at 7:30, check the weather and tell us if we need umbrellas.\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prüfe an jedem Werktag um 7:30 das Wetter und sag uns, ob wir Regenschirme brauchen.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Cada día entre semana a las 7:30, mira el tiempo y dinos si necesitamos paraguas»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Chaque jour de semaine à 7 h 30, regarde la météo et dis-nous s’il faut prendre un parapluie. »"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Каждый будний день в 7:30 проверяй погоду и говори нам, нужен ли зонт»."
          }
        }
      }
    },
    "\"Remind Anna tomorrow at 17:00 to pick up the parcel.\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erinnere Anna morgen um 17:00, das Paket abzuholen.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Recuérdale a Anna mañana a las 17:00 que recoja el paquete»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rappelle à Anna demain à 17 h d’aller chercher le colis. »"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Напомни Анне завтра в 17:00 забрать посылку»."
          }
        }
      }
    },
    "%@ answered with an error (%lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mit einem Fehler geantwortet (%2$lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió con un error (%2$lld)."
          }
        },
        "fr" : {
