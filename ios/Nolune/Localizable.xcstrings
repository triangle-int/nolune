    "Forgot your password? Ask an admin to reset it under People, or to run %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort vergessen? Bitte einen Admin, es unter Personen zurückzusetzen oder %@ auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Olvidaste la contraseña? Pide a un administrador que la restablezca en Personas o que ejecute %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot de passe oublié ? Demandez à un administrateur de le réinitialiser dans Personnes, ou d’exécuter %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыли пароль? Попросите администратора сбросить его в разделе «Люди» или выполнить %@."
          }
        }
      }
    },
