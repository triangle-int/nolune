    "Everyone here sees and writes in the same chats, and can ask nolune for anything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle hier sehen dieselben Chats, schreiben darin und können nolune um alles bitten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos aquí ven y escriben en los mismos chats, y pueden pedirle a nolune cualquier cosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde ici voit les mêmes discussions, y écrit, et peut demander n’importe quoi à nolune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
