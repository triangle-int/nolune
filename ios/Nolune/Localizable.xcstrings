    "There's no nolune at %@. Check the name with whoever set it up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter %@ gibt es kein nolune. Frag die Person, die es eingerichtet hat, nach dem Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún nolune en %@. Pregúntale el nombre a quien lo configuró."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas de nolune à l’adresse %@. Vérifiez le nom auprès de la personne qui l’a installé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По адресу %@ нет nolune. Уточните имя у того, кто его настроил."
          }
        }
      }
    },
    "Too many attempts. Wait a minute and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Versuche. Warte eine Minute und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos. Espera un minuto y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives. Patientez une minute et réessayez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много попыток. Подождите минуту и попробуйте снова."
