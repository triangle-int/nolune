    "Wrong email or password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mail oder Passwort ist falsch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correo o contraseña incorrectos."
          }
        },
        "fr" : {
