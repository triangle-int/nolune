          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL del webhook. Mantenla en secreto: cualquiera que la tenga puede iniciar una ejecución. Envíale JSON con POST."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL du webhook. Gardez-la secrète : toute personne qui l’a peut lancer une exécution. Envoyez-lui du JSON en POST."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL вебхука. Держите его в секрете: любой, у кого он есть, может запустить автоматизацию. Отправляйте на него JSON методом POST."
          }
