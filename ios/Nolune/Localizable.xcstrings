    "Everyone in your profiles sees your name and picture, and nolune reads your name with each message you send." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle in deinen Profilen sehen deinen Namen und dein Bild, und nolune liest deinen Namen mit jeder Nachricht, die du schickst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos en tus perfiles ven tu nombre y tu foto, y nolune lee tu nombre con cada mensaje que envías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde dans vos profils voit votre nom et votre photo, et nolune lit votre nom avec chaque message que vous envoyez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше имя и фото видят все в ваших профилях, а nolune читает ваше имя с каждым вашим сообщением."
          }
        }
      }
    },
